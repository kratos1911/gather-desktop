# Future public desktop configuration. Not consumed by the fixture preview yet.
# Public keys are still subject to Supabase RLS; they are not an authorization bypass.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER add a Supabase service-role/secret key, database password, or shared
# model-provider credential to a VITE_ variable or a distributed desktop build.
# Local models do not require a paid model-provider API key.
